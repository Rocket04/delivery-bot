# Telegram
BOT_TOKEN=123456789:AAFakeToken----replace-me
ADMIN_IDS=5935155979,761958359
# id группы операторов (число, со знаком минус для группы)
OPERATOR_CHAT_ID=-5439223806
# кто может жать кнопки в группе операторов (через запятую)
OPERATOR_IDS=5935155979,761958359

# База данных (локальная разработка)
DB_URL=postgresql+asyncpg://delivery:delivery@localhost:5432/delivery
# ПРОДАКШН: пароль БД ставится в .env на VPS (см. docs/DEPLOY.md); в compose
# подставляется как POSTGRES_PASSWORD, DB_URL контейнера compose собирает сам.
POSTGRES_PASSWORD=delivery

# Бизнес-правила (тенге, минуты/часы лида)
MIN_ORDER_AMOUNT=20000
PREPAY_PERCENT=50
LARGE_ORDER_THRESHOLD=60000
DEFAULT_LEAD_MINUTES=1440
LARGE_ORDER_LEAD_HOURS=48
DISH_DEPOSIT_AMOUNT=10000
APP_TZ=Asia/Almaty

# Окно приготовления: время доставки должно попадать в него (ночью не готовим)
DELIVERY_START_HOUR=8
DELIVERY_END_HOUR=23

# ИИ-ассистент (эксперимент exp/ai-assistant)
# LLM_PROVIDER: mock (без ключа, для тестов) | deepseek (api.deepseek.com) | opencode (opencode.ai/zen/go/v1)
LLM_PROVIDER=mock
# LLM_API_KEY=sk-... — ключ провайдера; в репозиторий писать нельзя
# LLM_MODEL=deepseek-v4-flash — у opencode-go также: deepseek-v4-pro, deepseek-v4-flash-vision-exp
# LLM_BASE_URL= — пусто = дефолт провайдера
LLM_MAX_TOKENS=240